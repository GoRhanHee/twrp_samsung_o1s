/system_image        ext4      /dev/block/mapper/system              flags=display="System Image";backup=1;flashimg
/vendor_image             ext4      /dev/block/mapper/vendor              flags=display="Vendor Image";backup=1;flashimg
/product_image            ext4      /dev/block/mapper/product             flags=display="Product Image";backup=1;flashimg
/odm_image                ext4      /dev/block/mapper/odm                 flags=display="ODM Image";backup=1;flashimg

/boot               emmc      /dev/block/bootdevice/by-name/boot               flags=display="Boot";backup=1;flashimg
/recovery           emmc      /dev/block/bootdevice/by-name/recovery           flags=display="Recovery";backup=1;flashimg
/metadata           ext4      /dev/block/bootdevice/by-name/metadata           flags=display="Metadata";backup=1
/data               f2fs      /dev/block/bootdevice/by-name/userdata           flags=display="Data";backup=1;wipeingui
/cache              ext4      /dev/block/bootdevice/by-name/cache              flags=display="Cache";backup=1
/efs                ext4      /dev/block/bootdevice/by-name/sec_efs            flags=display="EFS";backup=1
/sec_efs            ext4      /dev/block/bootdevice/by-name/sec_efs            flags=display="Sec EFS";backup=1
/modem		        emmc	  /dev/block/bootdevice/by-name/radio	           flags=display="Modem";backup=1
/misc               emmc      /dev/block/bootdevice/by-name/misc               flags=display="Misc";backup=1

/keydata            ext4      /dev/block/bootdevice/by-name/keydata            flags=display="Keydata";backup=1;wipeingui
/keyrefuge          f2fs      /dev/block/bootdevice/by-name/keyrefuge          flags=display="Keyrefuge";backup=1;wipeingui

/dtbo               emmc      /dev/block/bootdevice/by-name/dtbo               flags=display="Dtbo";backup=1;flashimg
/prism              ext4      /dev/block/bootdevice/by-name/prism              flags=display="Prism Image";backup=1;flashimg
/optics             ext4      /dev/block/bootdevice/by-name/optics             flags=display="Optics Image";backup=1;flashimg
/vbmeta_system      emmc      /dev/block/bootdevice/by-name/vbmeta_system      
/vendor_boot        emmc      /dev/block/bootdevice/by-name/vendor_boot        flags=display="Vednor Boot";backup=1;flashimg
/vbmeta_samsung     emmc      /dev/block/bootdevice/by-name/vbmeta_samsung     

# External Device
/external_sd    auto    /dev/block/mmcblk0p1 /dev/block/mmcblk0 flags=display="External SD Card";storage;wipeingui;removable
/usb-otg        auto    /dev/block/sdf1 /dev/block/sdf          flags=display="USB OTG";storage;wipeingui;removable
